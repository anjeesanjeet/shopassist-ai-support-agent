# ---- LLM provider: anthropic or openai ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2

# Prices in USD per 1M tokens, used for cost tracking.
# Check your provider's current pricing page and update these.
ANTHROPIC_PRICE_INPUT_PER_MTOK=1.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=5.0
OPENAI_PRICE_INPUT_PER_MTOK=0.40
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60

# ---- Business policy (enforced in code) ----
STORE_NAME=Loom & Ladle
AUTO_REFUND_LIMIT=200
RETURN_WINDOW_DAYS=30

# ---- Agent ----
MAX_TOOL_ROUNDS=6
HISTORY_LIMIT=40

# ---- Storage / server ----
DB_PATH=data/shop.db
HOST=127.0.0.1
PORT=8000

# ---- WhatsApp via Twilio (optional) ----
# Set both to enable webhook signature validation.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
